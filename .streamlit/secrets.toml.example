# Modelo de .streamlit/secrets.toml (o arquivo real NÃO é versionado).
# Use valores do seu provedor de identidade institucional. Nada aqui é um segredo real.

ETI_AMBIENTE = "producao"
ETI_CHAVE_PSEUDONIMIZACAO = "substitua-por-64-caracteres-hexadecimais-gerados-com-secrets.token_hex"
ETI_USUARIOS_AUTORIZADOS = "coordenador1@instituicao.edu.br, coordenador2@instituicao.edu.br"
ETI_ADMINISTRADORES = "administrador@instituicao.edu.br"

# Login OIDC nativo do Streamlit (st.login). Exemplo com Microsoft Entra ID (Azure AD);
# para Google Workspace, use server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration".
[auth]
redirect_uri = "https://painel.instituicao.edu.br/oauth2callback"
cookie_secret = "gere-um-valor-aleatorio-longo"
client_id = "id-do-aplicativo-registrado"
client_secret = "segredo-do-aplicativo-registrado"
server_metadata_url = "https://login.microsoftonline.com/<id-do-locatario>/v2.0/.well-known/openid-configuration"
