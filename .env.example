# Copie para .env (que não é versionado) ou defina as variáveis no ambiente/nos segredos do servidor.
# Os mesmos nomes podem ir em .streamlit/secrets.toml (ex.: ETI_AMBIENTE = "producao").

# demonstracao (dados fictícios, padrão) | local (dados reais nesta máquina) | producao
ETI_AMBIENTE=demonstracao

# Pasta com banco SQLite, chave de pseudonimização e cache do Inep. Fora do controle de versão.
ETI_DIRETORIO_DADOS=data/privado

# Chave HMAC (64 caracteres hexadecimais recomendados) para pseudonimizar CPF e e-mail.
# Obrigatória em produção. Em uso local, se ausente, é gerada em ETI_DIRETORIO_DADOS/.chave_pseudonimizacao.
# Trocar a chave invalida as decisões manuais de conciliação. Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
ETI_CHAVE_PSEUDONIMIZACAO=

# E-mails autorizados (separados por vírgula). Administradores também podem importar e conciliar.
ETI_USUARIOS_AUTORIZADOS=
ETI_ADMINISTRADORES=
# Quem pode exibir dados de contato na ficha individual (padrão: os administradores).
ETI_ACESSO_CONTATOS=

# Somente em uso local: dispensa o login se o servidor estiver ligado em localhost.
ETI_PERMITIR_ACESSO_LOCAL_SEM_LOGIN=0
# Nome do provedor em [auth.<nome>] do secrets.toml, se houver mais de um.
ETI_PROVEDOR_OIDC=

ETI_FUSO_HORARIO=America/Sao_Paulo
# Quantas versões de cada base manter (mínimo 2: a atual e a anterior, para comparação).
ETI_RETENCAO_IMPORTACOES=3
# 1 = exibir a marca oficial (arquivo em assets/marca/), somente com autorização institucional.
ETI_EXIBIR_MARCA=0
